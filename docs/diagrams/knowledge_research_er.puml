entity "METHOD / METHOD_VERSION" as Method #E9D5FF
entity "IMPLEMENTATION_VERSION" as Impl #E9D5FF
entity "EXPERIMENT_RUN" as Run #CCFBF1
entity "EVALUATION / METRIC_RESULT" as Eval #CCFBF1
entity "EVIDENCE" as Evidence #FEF3C7
entity "EVIDENCE_SYNTHESIS" as Synth #FEF3C7
entity "RESEARCH_QUESTION / KNOWLEDGE_GAP" as Question #FCE7F3
entity "EXPERIMENT_PROPOSAL" as Proposal #FCE7F3
entity "REVIEW_DECISION / EXECUTION_APPROVAL" as Approval #FEE2E2
Pub ||--o{ SA
Pub ||--o{ PE
SA }o--o{ Claim : interpreted_as
PE }o--o{ Method : describes
Method ||--o{ Impl : implemented_by
Impl ||--o{ Run : used_in
Run ||--o{ Eval
PE }o--o{ Evidence : grounding
Eval }o--o{ Evidence : measurement
Evidence }o--o{ Claim : stance
Evidence }o--o{ Synth
Claim ||--o{ Synth
Concept }o--o{ Claim : typed_relation
